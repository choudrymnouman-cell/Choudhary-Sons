APP_NAME=Choudhary & Sons API
ENVIRONMENT=development

# Paste the Supabase Postgres connection string from Project Settings > Database > Connect.
# The app automatically normalizes postgresql:// to SQLAlchemy's psycopg driver.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://localhost:8080,https://choudrymnouman-cell.github.io

# Supabase Storage (server-side only: never expose the service role key in Flutter/web).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=company-documents
